# rls-legacy — dashboard (captain). Copia este archivo a `.env` y rellena:
#   cp compose.env.example .env
#
# RLS_JWT_SECRET — sí
#   Secreto de firma de las sesiones JWT. OBLIGATORIO en producción:
#     openssl rand -hex 32   (o: docker run --rm alpine:3.20 sh -c 'head -c32 /dev/urandom | od -An -tx1 | tr -d " \n"; echo')
#   Si queda vacío, el backend genera uno efímero en memoria: los logins se
#   invalidan en cada reinicio (solo aceptable para probar en local).
RLS_JWT_SECRET=

# RLS_RETENTION_DAYS — opcional (default 7, REQ-040)
#   Días de retención de métricas y alertas resueltas. El pruner limpia
#   cada hora el bind mount ./data (la DB vive en captain/data/rls.db).
RLS_RETENTION_DAYS=7

# RLS_PORT — opcional (default 3008)
#   Puerto del host donde publicas el dashboard (Bun escucha :3008 dentro del contenedor).
RLS_PORT=3008

# ─── Notificaciones de alertas (REQ-050) ────────────────────────────────────
# Se notifica `alert_new` (offline / high_cpu / high_ram) y `alert_resolved`
# de esas mismas clases. NUNCA se notifican los heartbeats.
# Todo es OPCIONAL: si no configuras ningún canal, el notifier queda inerte
# (sin goroutine). Puedes activar Discord, Telegram o ambos.
# Prueba el canal sin esperar una alerta real:
#   curl -X POST -H 'Content-Type: application/json' \
#        -b cookies.txt -d '{"channel":"discord"}' https://TU-DOMINIO/api/v1/notify/test
#   (201 ok / 503 canal sin configurar / 502 el canal rechazó el envío)

# RLS_NOTIF_DISCORD_WEBHOOK_URL — opcional
#   CÓMO CONSEGUIRLO: entra en tu servidor de Discord → Ajustes del servidor
#   (Server Settings) → Integraciones → Webhooks → "Nuevo webhook" → elige el
#   canal → "Copiar URL del webhook" (https://discord.com/api/webhooks/...).
#   Pega la URL COMPLETA aquí. Nota: el bot solo puede escribir en el canal
#   para el que creaste el webhook.
RLS_NOTIF_DISCORD_WEBHOOK_URL=

# RLS_NOTIF_TELEGRAM_BOT_TOKEN — opcional (junto a RLS_NOTIF_TELEGRAM_CHAT_ID)
#   CÓMO CONSEGUIRLO: 1) habla con @BotFather en Telegram → /newbot →
#   sigue el asistente → te da el TOKEN (formato 123456789:AA...). 2) Invita
#   al bot a tu chat/grupo (o mándale un mensaje directo): los bots NO pueden
#   iniciar conversación sin ese primer mensaje. 3) Obtén el chat_id:
#   manda un mensaje al chat del bot y luego abre
#     https://api.telegram.org/bot<TOKEN>/getUpdates
#   y copia `result[0].message.chat.id`. Ambos valores son obligatorios:
#   si falta uno, Telegram queda deshabilitado.
RLS_NOTIF_TELEGRAM_BOT_TOKEN=
RLS_NOTIF_TELEGRAM_CHAT_ID=

# RLS_PUBLIC_URL — OBLIGATORIO
#   URL base del dashboard que usarán las VPS para descargar el instalador y
#   el binario Stowaway. Debe ser HTTPS en servidores remotos. HTTP solo se
#   admite para pruebas en localhost, por ejemplo http://localhost:3008.
#   También se usa para los links del panel en alertas externas.
#   En producción: https://rls.tudominio.com
RLS_PUBLIC_URL=
